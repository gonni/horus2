# ==============================================================================
# Horus Server - Backend Core Environment Variables
# ==============================================================================

# PostgreSQL
POSTGRES_USER=horus
POSTGRES_PASSWORD=horus_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=horus

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=horus_redis

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=horus_graph

# Hybrid LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:27b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Security
SECRET_KEY=horus_jwt_super_secret_key_change_in_prod
ACCESS_TOKEN_EXPIRE_MINUTES=10080
