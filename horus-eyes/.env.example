# ==============================================================================
# Horus Eyes - AI Crawler Environment Variables
# ==============================================================================

# PostgreSQL
POSTGRES_USER=horus
POSTGRES_PASSWORD=horus_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=horus

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=horus_redis

# LLM for AI Parsing & Vision
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b-mlx
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Crawler Settings
MAX_CONCURRENCY=5
REQUEST_TIMEOUT=20.0
HORUS_IMAGE_STORE_DIR=./data/images
