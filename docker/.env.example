# ==============================================================================
# Horus 2.0 - Docker Infrastructure Environment Variables
# ==============================================================================

# Data Volume Root (호스트 머신의 데이터 저장 위치, 기본: ./data)
DOCKER_DATA_ROOT=./data

# PostgreSQL 16 (TimescaleDB + pgvector + pg_trgm)
POSTGRES_USER=horus
POSTGRES_PASSWORD=horus_secret
POSTGRES_DB=horus
POSTGRES_PORT=5432

# Redis 7 (Celery Broker & MAB Cache)
REDIS_PASSWORD=horus_redis
REDIS_PORT=6379

# Neo4j 5.20 Community (Knowledge Graph)
NEO4J_USER=neo4j
NEO4J_PASSWORD=horus_graph
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
