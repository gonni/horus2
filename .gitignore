# ==============================================================================
# Horus 2.0 - Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 2. Node.js / Next.js / Frontend
# ------------------------------------------------------------------------------
node_modules/
.next/
out/
.nuxt/
.vuepress/dist
.serverless/
.fusebox/
.dynamodb/
.tern-port

# TypeScript build info
*.tsbuildinfo

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. Testing, Coverage & Linters
# ------------------------------------------------------------------------------
.cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.coverage
.coverage.*
.hypothesis/
htmlcov/
.tox/
.nox/

# Playwright Test Output
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ------------------------------------------------------------------------------
# 4. Logs, Temp & Media Data
# ------------------------------------------------------------------------------
*.log
logs/
*.pid
*.seed
*.pid.lock
*.tmp
*.temp

# Local image downloads and runtime data
data/
docker/data/
docker-runtime/
*.sqlite3
*.db

# ------------------------------------------------------------------------------
# 5. Environment Variables & Secret Files
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Preserve template files
!.env.example
!docker/.env.example
!horus-server/.env.example
!horus-eyes/.env.example

# ------------------------------------------------------------------------------
# 6. Operating System & IDEs
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.settings/
.classpath
